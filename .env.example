# Configurações do Banco de Dados Supabase (preencha em um .env.local NÃO versionado)
SUPABASE_URL=
SUPABASE_KEY=

# Variáveis usadas pelo cliente no navegador (Vite só expõe as com prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave de API do Gemini para IA e recursos de triagem inteligente
GEMINI_API_KEY=
