# Configurações do Banco de Dados Supabase (Secrets no AI Studio ou arquivo .env local)
SUPABASE_URL=
SUPABASE_KEY=

# Suporte para banco de dados local/auto-hospedado (como mostrado no .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de API do Gemini para IA e recursos de triagem inteligente
GEMINI_API_KEY=

# URL base do servidor backend (usado pelo frontend para montar as chamadas de API)
# Em produção, aponte para o domínio do servidor Node.js (ex: https://api.gran7help.com)
# Em desenvolvimento local, deixe vazio (usa URL relativa, o Vite fará o proxy)
VITE_API_URL=

# Domínio do frontend permitido pelo servidor backend (CORS)
# Exemplo: https://gran7help.com  (sem barra no final)
# Deixe * para permitir qualquer origem (menos seguro)
ALLOWED_ORIGIN=*
